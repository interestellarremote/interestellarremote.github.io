rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /artifacts/{deviceId}/{conversationId}/{fileName} {
      allow read: if request.auth != null
        && firestore.get(/databases/(default)/documents/devices/$(deviceId)).data.ownerUid == request.auth.uid;
      allow write: if request.auth != null
        && request.auth.token.deviceId == deviceId
        && request.auth.token.type == 'bridge'
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType == 'application/octet-stream';
    }
  }
}

