{
  "name": "antigravity-remote-functions",
  "private": true,
  "engines": { "node": "22" },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "test": "npm run build",
    "test:rules": "firebase emulators:exec --config ../firebase.json --only database \"node --test test/rules.test.mjs\"",
    "serve": "npm run build && firebase emulators:start --only functions,database,auth,storage",
    "deploy": "firebase deploy --only functions,database,storage"
  },
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.0"
  },
  "overrides": {
    "uuid": "^14.0.1",
    "retry-request": "^8.0.3",
    "@opentelemetry/core": "^2.9.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^15.24.0",
    "typescript": "^5.7.2"
  }
}
